# ───────────── Server ─────────────
PORT=5000
NODE_ENV=development
# Public URL of the site (used in password-reset emails)
APP_URL=http://localhost:5000

# ───────────── Database (REQUIRED) ─────────────
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/resumeiq
MONGO_URI=

# ───────────── Auth (REQUIRED) ─────────────
# Any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How many days a login stays valid
JWT_EXPIRES_DAYS=7

# ───────────── AI API (REQUIRED for analysis) ─────────────
# Choose one provider: anthropic | gemini | openai
AI_PROVIDER=anthropic

# >>> PUT YOUR AI API KEY HERE (only the one for your chosen provider) <<<
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ───────────── Google sign-in (optional) ─────────────
# OAuth Client ID (type: Web application) from https://console.cloud.google.com/apis/credentials
# Add http://localhost:5000 to "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=

# ───────────── Email for password reset (optional) ─────────────
# Without SMTP, the reset link is printed in the server console (and shown on the page in development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ResumeIQ <no-reply@example.com>"
